# 账户状态文件、目录或逗号分隔的多个路径
AISTUDIO_AUTH_STATES=auth

# 服务监听地址
LISTEN_ADDR=127.0.0.1:2048

# 本地 API 认证密钥
PROXY_API_KEY=

# setup 与未指定账户共同使用的 HTTP、HTTPS 或 SOCKS5 代理
PROXY=

# 单账户初始化超时
INIT_TIMEOUT=2m

# 普通请求最大执行时间
REQUEST_TIMEOUT=5m

# 常驻预热账户数
WARM_WORKER_LIMIT=5

# 高峰期最多同时运行的 Worker 数
MAX_ACTIVE_WORKERS=10

# 服务启动时同时预热的账户数
WARM_STARTUP_CONCURRENCY=2

# 单账号同时处理的请求数
PER_ACCOUNT_CONCURRENCY=2

# WAA 预热是否使用临时对话
TEMPORARY_CHAT=false

# ===================== HuggingFace/容器部署专用 =====================
# 多账户凭证 JSON 数组,支持 base64: 或 gzip: 前缀(推荐 gzip: 应对 HF 64KB 限制)
# 格式: [{"email":"a@gmail.com","storage_state":{...},"proxy":"http://..."}, ...]
# storage_state 为 Playwright storage state 文件完整内容
# 如 storage_state 已包含 aistudio2api 扩展(带 email),可省略外层 email
# 启动后所有账户写入 $AISTUDIO_AUTH_STATES/<email>/,仅 ACTIVE 账户 Enabled=true
# 生成 gzip 编码: gzip -c auth.json | base64 -w0
AISTUDIO_AUTH_ACCOUNTS=

# 启动时启用的账户邮箱;为空时启用 AISTUDIO_AUTH_ACCOUNTS 第一个账户
# 切换账户: 在管理界面"账户"页停用当前账户并启用目标账户,无需重启
AISTUDIO_ACTIVE_EMAIL=

# 注入账户的默认代理(账户 JSON 中未指定 proxy 时使用)
# 也支持通过全局 PROXY 环境变量配置;账户级别 proxy > AISTUDIO_DEFAULT_PROXY > PROXY
AISTUDIO_DEFAULT_PROXY=

# 注入账户的默认 locale/timezone(账户 JSON 中未指定时使用)
# AISTUDIO_DEFAULT_LOCALE=en-US
# AISTUDIO_DEFAULT_TIMEZONE=Asia/Shanghai

# Camoufox 可执行文件路径;Docker 镜像中已预置到 /app/runtime/camoufox/camoufox-bin
CAMOUFOX_PATH=

# 管理端鉴权 token;非空时管理界面和 /api/* 要求鉴权(HF/容器部署必填)
# 浏览器访问 Web 界面: 弹 Basic Auth,user 填本 token,password 留空
# API/脚本调用: 加 X-Admin-Token 头
# 不设置则仅允许 loopback 访问(本地部署默认行为)
ADMIN_TOKEN=

# 是否启用 active 账号失效自动切换(检测到 auth_required 自动切下一个备用账号)
# HF 部署强烈推荐开启,避免人工干预
# Docker 镜像默认 true
AISTUDIO_FAILOVER=true

